# ---------------------------------------------------------------------------
# Hearth environment variables
# Copy to .env.local and fill in. NEVER commit real secrets.
#
# Production (NODE_ENV=production) is strict and refuses to boot unless:
#   - QLOO_API_KEY is set          (live taste data is mandatory)
#   - UPSTASH_REDIS_REST_URL+TOKEN (shared cache/rate-limit/budget/share store)
#   - QLOO_MODE is not "fixtures"  (mock data is never served in production)
# Blank values are treated as "unset", so a host that injects empty vars is safe.
#
# Loading: Next.js reads this file automatically via its built-in loader (no
# `dotenv` dependency required). Public values must be prefixed NEXT_PUBLIC_;
# everything else stays server-only. Ad-hoc scripts can opt in with:
#   node --env-file=.env.local script.mjs
# ---------------------------------------------------------------------------

# Public site URL used for metadata / Open Graph. Safe to expose.
NEXT_PUBLIC_SITE_URL=https://hearth.app

# Qloo Taste API (server only)
QLOO_API_KEY=
QLOO_BASE_URL=https://hackathon.api.qloo.com/v2
# "auto" = live when a key is present, otherwise fixtures (dev/test only).
# "live" = always call the real API. "fixtures" = recorded data (never in prod).
QLOO_MODE=auto
# Per-request timeout (ms) for Qloo calls. Lower = snappier, riskier.
QLOO_TIMEOUT_MS=6500

# LLM provider (server only). Any OpenAI-compatible chat completions endpoint.
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# Upstash Redis (optional). When unset, Hearth falls back to an in-memory cache
# and rate limiter, which is fine for local development and the demo.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Abuse controls
RATE_LIMIT_PER_MINUTE=12
DAILY_QLOO_BUDGET=4000
DAILY_LLM_BUDGET=2000
